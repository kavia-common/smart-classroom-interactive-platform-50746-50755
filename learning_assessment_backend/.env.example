# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

# Frontend origin (React runs on port 3000)
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (preferred: DATABASE_URL)
# Based on learning_assessment_database/db_connection.txt:
# postgresql://appuser:dbuser123@localhost:5001/myapp
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5001/myapp

# Alternatively, explicit fields:
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# Optional: mount a db_connection.txt file at this path
# DB_CONNECTION_FILE=/path/to/db_connection.txt

# Non-interactive first-run admin creation:
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_EMAIL=admin@example.com
